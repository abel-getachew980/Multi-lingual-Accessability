# AI Provider Configuration
AI_PROVIDER=offline

# Cloud AI (if using cloud provider)
CLOUD_AI_API_KEY=your-api-key-here
CLOUD_AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# Local AI (if using local model)
LOCAL_AI_ENDPOINT=http://localhost:8000
LOCAL_AI_MODEL=llama-3

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram

# SMS Gateway (optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-account-sid
SMS_AUTH_TOKEN=your-auth-token
SMS_FROM_NUMBER=+1234567890

# Human Help (optional)
WEBRTC_SIGNALING_SERVER=wss://your-server.com

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
