# AI Provider Configuration
AI_PROVIDER=offline

# Cloud AI (if using cloud provider)
CLOUD_AI_API_KEY=your-api-key-here
CLOUD_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
CLOUD_AI_MODEL=gpt-4o-mini

# Local AI (if using local model)
LOCAL_AI_ENDPOINT=http://localhost:8000
LOCAL_AI_MODEL=llama-3

# Telegram Bot (standalone bot in telegram-bot/, see telegram-bot/README.md)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram
# Where /api/telegram forwards updates when the bot runs separately
TELEGRAM_BOT_URL=http://localhost:3002

# Voice notes need a Whisper-compatible transcription endpoint
# TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_MODEL=whisper-1

# SMS Gateway (optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-account-sid
SMS_AUTH_TOKEN=your-auth-token
SMS_FROM_NUMBER=+1234567890
# Standalone gateway used by the /api/sms webhook (see sms-gateway/README.md)
SMS_GATEWAY_URL=http://localhost:3001
# Public URL Twilio calls; required to verify webhook signatures
TWILIO_WEBHOOK_URL=https://your-domain.com/api/sms

# Human Help (optional)
WEBRTC_SIGNALING_SERVER=wss://your-server.com

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
