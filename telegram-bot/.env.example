# Telegram bot (https://core.telegram.org/bots#botfather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# polling (local) or webhook (public)
TELEGRAM_MODE=polling
TELEGRAM_BOT_PORT=3002
TELEGRAM_WEBHOOK_PATH=/telegram
# Required in webhook mode. Telegram echoes this in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=change-me
# Optional: public URL registered with Telegram on startup.
TELEGRAM_BOT_WEBHOOK_URL=https://your-domain.com/telegram

# The Next.js app the bot calls.
APP_BASE_URL=http://localhost:3000
# AI_API_URL=http://localhost:3000/api/ai
# HELP_API_URL=http://localhost:3000/api/help
AI_PROVIDER=offline
AI_TIMEOUT_MS=15000
HELP_TIMEOUT_MS=5000
HELP_REQUEST_COOLDOWN_MS=600000

TELEGRAM_DEFAULT_LANGUAGE=am
TELEGRAM_MAX_QUESTION_LENGTH=1000
TELEGRAM_MAX_HISTORY_TURNS=8
TELEGRAM_RATE_LIMIT_MAX=20
TELEGRAM_RATE_LIMIT_WINDOW_MS=60000
TELEGRAM_SESSION_TTL_MS=86400000
TELEGRAM_MAX_VOICE_SECONDS=120
TELEGRAM_MAX_VOICE_BYTES=5242880

# Optional Whisper-compatible endpoint for voice notes.
# Leave unset to tell learners that voice is unavailable.
# TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_LANGUAGE=am
# TRANSCRIPTION_TIMEOUT_MS=20000
