# SMS Gateway
PORT=3001

# console (logs to stdout) | twilio
SMS_PROVIDER=console
# twiml (reply in webhook response) | api (send through the provider API)
SMS_REPLY_MODE=twiml

# AI app
AI_API_URL=http://localhost:3000
# cloud | local | offline (optional, passed through to /api/ai)
# AI_PROVIDER=offline
AI_TIMEOUT_MS=8000

# Help desk (defaults to ${AI_API_URL}/api/help)
# HELP_API_URL=http://localhost:3000/api/help
HELP_TIMEOUT_MS=5000
# Repeated HELP messages inside this window reuse the open ticket
HELP_REQUEST_COOLDOWN_MS=600000

# Behaviour
SMS_DEFAULT_LANGUAGE=am
SMS_MAX_SEGMENTS=3
SMS_MAX_QUESTION_LENGTH=500
SMS_MAX_HISTORY_TURNS=6
SMS_RATE_LIMIT_MAX=10
SMS_RATE_LIMIT_WINDOW_MS=60000
SMS_SESSION_TTL_MS=86400000

# Twilio (required when SMS_PROVIDER=twilio)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
# Public URL Twilio is configured to call; used to verify X-Twilio-Signature
TWILIO_WEBHOOK_URL=https://your-domain.com/api/sms
